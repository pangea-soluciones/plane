# Copia a .env junto a tus docker-compose en el servidor (no commitees secretos).

ACME_EMAIL=admin@yomogo.io
PLANE_API_HOST=plane-api.yomogo.io
PLANE_WEB_HOST=plane-web.yomogo.io

# Si el directorio del proyecto no se llama "plane", fija el nombre de red que usa Traefik:
# COMPOSE_PROJECT_NAME=plane

# API (ajusta a tu despliegue)
WEB_URL=https://plane-web.yomogo.io
CORS_ALLOWED_ORIGINS=https://plane-web.yomogo.io
