# Copia a .env junto a tus docker-compose en el servidor (no commitees secretos).
# Alineado con deployments/cli/community/variables.env — certificados los gestiona plane-proxy (Caddy).

APP_DOMAIN=plane-web.yomogo.io
WEB_URL=https://plane-web.yomogo.io
CORS_ALLOWED_ORIGINS=https://plane-web.yomogo.io

# Let's Encrypt vía proxy oficial (obligatorio para cert automático)
CERT_EMAIL=admin@yomogo.io
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
