# Copia a .env junto a tus docker-compose en el servidor (no commitees secretos).
# Base del compose: deployments/cli/community/docker-compose.yml (no uses el docker-compose.yml raíz del repo en EC2: fuerza build local de space y rompe el deploy por SSH).
# Alineado con deployments/cli/community/variables.env — certificados los gestiona plane-proxy (Caddy).
# En AWS ECR (us-east-1) deben existir los repos: plane-api, plane-web, plane-proxy (el CI las rellena; créalos vacíos si hace falta).

APP_DOMAIN=plane-web.lideris.com.co
WEB_URL=https://plane-web.lideris.com.co
CORS_ALLOWED_ORIGINS=https://plane-web.lideris.com.co

# Dominio público para Caddy (TLS). Sin https:// ni barra final.
SITE_ADDRESS=plane-web.lideris.com.co

# Let's Encrypt vía proxy (solo la dirección de correo, sin la palabra "email")
CERT_EMAIL=gerencia@pangeasoluciones.com
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
